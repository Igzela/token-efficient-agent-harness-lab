# Agent Control Plane — Environment Configuration
# Copy this file to .env and adjust values as needed.

# --- Profile ---
# Startup profile: "local" (default, dev-friendly) or "production" (enforces auth, CORS, backup)
# In production profile: auth required, CORS must not be *, backup dir required.
ACP_PROFILE=local

# --- Network ---
# Bind address (127.0.0.1 = local only, 0.0.0.0 = LAN-exposed)
HOST=127.0.0.1
# Listen port
PORT=8080

# --- TLS (disabled by default) ---
# Path to PEM certificate chain file (enables HTTPS when both cert and key are set)
# ACP_TLS_CERT_PATH=/path/to/cert.pem
# Path to PEM private key file
# ACP_TLS_KEY_PATH=/path/to/key.pem

# --- Storage ---
# PostgreSQL connection URL (optional, requires --features pg at build time)
# When set, overrides SQLite as the storage backend. SQLite is the default.
# ACP_DATABASE_URL=postgres://user:password@localhost:5432/acp
# SQLite database path (relative to working directory or absolute; ignored when ACP_DATABASE_URL is set)
ACP_DB_PATH=.agent-control-plane/local-team.db
# Backup directory (defaults to <db_parent>/backups; SQLite only)
# ACP_BACKUP_DIR=.agent-control-plane/backups
# SQLCipher encryption passphrase for SQLite database at rest (SQLite only)
# ACP_DB_ENCRYPTION_KEY=

# --- Dashboard ---
# Path to static dashboard assets (the dashboard/out/ directory)
# ACP_DASHBOARD_DIR=dashboard/out

# --- Authentication ---
# Enable API key authentication (1 or true to enable)
# ACP_REQUIRE_AUTH=1
# Admin API key — must match harness_<64 hex chars> shape
# Required when ACP_REQUIRE_AUTH=1
# ACP_ADMIN_API_KEY=harness_<64 hex chars>

# --- Provider ---
# Provider type: stub, openai_compatible, anthropic
# ACP_PROVIDER_TYPE=stub
# Recommended internal path: set ACP_TRUSTED_LOCAL_PROFILE=1 plus auth,
# endpoint metadata, symbolic credentials, positive pricing, and cost caps.
# The legacy standalone gate below also enables real provider calls.
# ACP_TRUSTED_LOCAL_PROFILE=1
# ACP_ENABLE_PROVIDER_EXECUTION=1
# API key for the configured provider
# ACP_API_KEY=
# Model name
# ACP_MODEL=default
# Base URL for provider API (required for openai_compatible and anthropic)
# ACP_BASE_URL=

# --- Adaptive provider portfolios ---
# Recommended internal path: a ready ACP_TRUSTED_LOCAL_PROFILE=1 composes
# provider/adaptive execution, experiments, promotion, and default routing.
# The legacy standalone gate below enables explicit adaptive_provider ticks.
# ACP_ENABLE_ADAPTIVE_FUSION_EXECUTION=1
# Emergency startup kill switch; blocks all adaptive calls when set.
# ACP_ADAPTIVE_FUSION_KILL_SWITCH=1
# JSON array of fixed provider/model endpoints. credential_env values are
# environment variable names, never secrets.
# ACP_ADAPTIVE_PROVIDER_ENDPOINTS_JSON=[{"endpoint_id":"fast","provider_type":"openai_compatible","base_url":"https://api.example.com/v1","model":"fast-model","credential_env":"FAST_PROVIDER_KEY","timeout_ms":30000,"input_cost_per_1k_usd":0.001,"output_cost_per_1k_usd":0.002}]
# AF-6 completion limits. The endpoint still requires provider, adaptive, and auth gates.
# ACP_ADAPTIVE_COMPLETION_MAX_COST_USD=1.0
# ACP_ADAPTIVE_COMPLETION_MAX_TOKENS=32768
# ACP_ADAPTIVE_COMPLETION_MAX_LATENCY_MS=300000
# ACP_ADAPTIVE_COMPLETION_OUTPUT_TOKENS=1024
# AF-6 controlled experiments are enabled by a ready trusted-local profile,
# or by both standalone legacy gates below.
# ACP_ENABLE_ADAPTIVE_EXPERIMENTS=1
# ACP_ADAPTIVE_EXPERIMENTS_ACTIVE=1
# ACP_ADAPTIVE_EXPERIMENT_TRAFFIC_RATE=0.01
# ACP_ADAPTIVE_EXPERIMENT_MAX_COST_USD=1.0
# ACP_ADAPTIVE_EXPERIMENT_MAX_TOTAL_TOKENS=32768
# ACP_ADAPTIVE_EXPERIMENT_MAX_CALLS=8
# ACP_ADAPTIVE_EXPERIMENT_MAX_ELAPSED_MS=300000
# ACP_ADAPTIVE_EXPERIMENT_MAX_CONCURRENCY=3
# ACP_ADAPTIVE_EXPERIMENTS_PAUSED=1
# ACP_ADAPTIVE_EXPERIMENTS_KILL_SWITCH=1
# AF-6 automatic promotion is enabled by a ready trusted-local profile,
# or by both standalone legacy gates below.
# ACP_ENABLE_ADAPTIVE_AUTO_PROMOTION=1
# ACP_ADAPTIVE_AUTO_PROMOTION_ACTIVE=1
# ACP_ADAPTIVE_AUTO_PROMOTION_MIN_SAMPLES=30
# ACP_ADAPTIVE_AUTO_PROMOTION_MIN_CONFIDENCE=0.85
# ACP_ADAPTIVE_AUTO_PROMOTION_MIN_QUALITY_DELTA=0
# ACP_ADAPTIVE_AUTO_PROMOTION_MIN_COST_REDUCTION=0
# ACP_ADAPTIVE_AUTO_PROMOTION_MIN_LATENCY_REDUCTION_MS=0
# ACP_ADAPTIVE_AUTO_PROMOTION_MAX_FAILURE_RATE_DELTA=0.02
# ACP_ADAPTIVE_AUTO_PROMOTION_MAX_EVIDENCE_AGE_SEQUENCES=1000
# ACP_ADAPTIVE_AUTO_PROMOTION_ROLLOUT_PERCENTAGE=10
# ACP_ADAPTIVE_AUTO_PROMOTION_KILL_SWITCH=1
# Optional standalone default /dispatch delegation without trusted-local profile.
# ACP_ADAPTIVE_DEFAULT_LIVE_ROUTING=1
# AF-4 adaptive policy promotion is disabled by default and requires both gates.
# ACP_ENABLE_ADAPTIVE_POLICY_PROMOTION=1
# ACP_ADAPTIVE_POLICY_PROMOTION_ACTIVE=1
# AF-4 bounded exploration is disabled by default and requires both gates.
# ACP_ENABLE_ADAPTIVE_EXPLORATION=1
# ACP_ADAPTIVE_EXPLORATION_ACTIVE=1
# ACP_ADAPTIVE_EXPLORATION_KILL_SWITCH=1

# --- Cost Gates ---
# Per-dispatch cost cap in USD (default: unlimited)
# ACP_COST_PER_DISPATCH_USD=1.00
# Daily cost cap in USD (default: unlimited)
# ACP_COST_DAILY_USD=10.00

# --- Execution Mode ---
# How dispatch requests are executed: "off" (default, noop), "provider" (API only),
# "cli" (CLI executor only), "auto" (hybrid: low complexity → provider, high → CLI)
# ACP_EXECUTION_MODE=off

# Complexity threshold for hybrid mode routing (0.0-1.0).
# Tasks below this score go to Provider API; above go to CLI executor.
# ACP_HYBRID_COMPLEXITY_THRESHOLD=0.5

# --- CLI Executor ---
# Local Claude/Codex discovery defaults on; set to 0 to disable subprocess execution.
# ACP_ENABLE_CLI_EXECUTION=0  # local Claude/Codex discovery defaults on; set 0 to disable
# Path to claude binary (auto-detected via `which claude` if not set)
# ACP_CLAUDE_CODE_BIN=/usr/local/bin/claude
# Path to codex binary (auto-detected via `which codex` if not set)
# ACP_CODEX_BIN=/usr/local/bin/codex
# CLI command timeout in milliseconds (default: 300000 = 5 min)
# ACP_CLI_TIMEOUT_MS=300000

# --- Scheduler ---
# Legacy standalone scheduler gates. Trusted-local task advancement uses
# ACP_TRUSTED_LOCAL_TASK_ADVANCEMENT=1 after ACP_TRUSTED_LOCAL_PROFILE=1 is ready.
# ACP_TRUSTED_LOCAL_TASK_ADVANCEMENT=1
# ACP_ENABLE_SCHEDULER=1
# Second gate required for bounded runtime workers
# ACP_ENABLE_SUPERVISED_WORKERS=1
# Worker threads, constrained to 1..ACP_SCHEDULER_MAX_CONCURRENT and hard-capped at 32
# ACP_SUPERVISED_WORKER_COUNT=2
# Pause new node claims while keeping worker threads alive
# ACP_SUPERVISED_WORKERS_PAUSED=1
# Emergency stop: workers stop claiming work and exit
# ACP_SUPERVISED_WORKERS_KILL_SWITCH=1
# Scheduler tick interval in milliseconds (default: 2000)
# ACP_SCHEDULER_INTERVAL_MS=2000
# Max concurrent ticks per cycle (default: 4)
# ACP_SCHEDULER_MAX_CONCURRENT=4
# Lease timeout for stuck nodes in milliseconds (default: 300000 = 5 min)
# ACP_SCHEDULER_LEASE_TIMEOUT_MS=300000
# Executor type for scheduler: noop, command, claude_code_cli, codex_cli (default: noop)
# ACP_SCHEDULER_EXECUTOR=claude_code_cli

# --- HA: Scheduler Heartbeat ---
# Interval for persisting heartbeat to SQLite in seconds (default: 10)
# ACP_HEARTBEAT_INTERVAL_SEC=10

# --- HA: Automated Backup ---
# Interval for automated backups in seconds (0 = disabled, default: 0)
# ACP_BACKUP_INTERVAL_SEC=3600
# Number of backups to retain when pruning (default: 5)
# ACP_BACKUP_RETAIN_COUNT=5

# --- HA: Health Monitoring ---
# Disk free percentage below which health reports degraded (default: 10.0)
# ACP_DISK_WARN_PCT=10.0
# Memory available percentage below which health reports degraded (default: 10.0)
# ACP_MEM_WARN_PCT=10.0
# Webhook URL for health state transition alerts (optional)
# ACP_HEALTH_ALERT_WEBHOOK_URL=https://hooks.example.com/health

# --- CORS ---
# Allowed origins for CORS (comma-separated, default: * for local dev)
# ACP_CORS_ORIGINS=http://localhost:3000,https://dashboard.example.com
