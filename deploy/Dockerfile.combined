# Stage 1: Build static dashboard
FROM oven/bun:1 AS dashboard-builder
WORKDIR /app
COPY dashboard/package.json dashboard/bun.lock* ./
RUN bun install --frozen-lockfile || bun install
COPY dashboard/ .
RUN bun run build:static

# Stage 2: Build Rust engine
FROM rust:bookworm AS rust-builder
WORKDIR /app
COPY Cargo.toml Cargo.lock* ./
COPY engine/Cargo.toml engine/Cargo.toml
ENV CARGO_NET_RETRY=10
ENV CARGO_HTTP_HTTP2=false
RUN mkdir -p engine/src \
  && printf 'pub fn dependency_cache_anchor() {}\n' > engine/src/lib.rs \
  && printf 'fn main() {}\n' > engine/src/main.rs \
  && cargo build --release -p engine --bin agent-control-plane \
  && rm -rf engine/src
COPY engine/ engine/
RUN find engine/src -type f -exec touch {} + \
  && cargo build --release -p engine --bin agent-control-plane

# Stage 3: Runtime
FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl \
    && rm -rf /var/lib/apt/lists/*

COPY --from=rust-builder /app/target/release/agent-control-plane /usr/local/bin/agent-control-plane
COPY --from=dashboard-builder /app/out /dashboard

ENV ACP_DASHBOARD_DIR=/dashboard
ENV HOST=0.0.0.0
ENV PORT=8080

EXPOSE 8080

HEALTHCHECK --interval=10s --timeout=5s --retries=3 \
    CMD curl -f http://localhost:8080/api/v1/health || exit 1

CMD ["agent-control-plane"]
