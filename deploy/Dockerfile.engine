FROM rust:bookworm AS builder
WORKDIR /app
COPY Cargo.toml Cargo.lock ./
COPY engine/Cargo.toml engine/Cargo.toml
ENV CARGO_NET_RETRY=10
ENV CARGO_HTTP_HTTP2=false
RUN mkdir -p engine/src \
  && printf 'pub fn dependency_cache_anchor() {}\n' > engine/src/lib.rs \
  && printf 'fn main() {}\n' > engine/src/main.rs \
  && cargo build --release -p engine --bin agent-control-plane \
  && rm -rf engine/src
COPY engine/ engine/
RUN find engine/src -type f -exec touch {} + \
  && cargo build --release -p engine --bin agent-control-plane

FROM debian:bookworm-slim
RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates curl \
  && rm -rf /var/lib/apt/lists/*
COPY --from=builder /app/target/release/agent-control-plane /usr/local/bin/agent-control-plane
ENV HOST=0.0.0.0
ENV PORT=8080
EXPOSE 8080
CMD ["agent-control-plane"]
