FROM rust:bookworm AS builder
WORKDIR /app
COPY Cargo.toml Cargo.lock ./
COPY engine/ engine/
ENV CARGO_NET_RETRY=10
ENV CARGO_HTTP_HTTP2=false
RUN cargo build --release -p engine

FROM debian:bookworm-slim
RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates curl \
  && rm -rf /var/lib/apt/lists/*
COPY --from=builder /app/target/release/agent-control-plane /usr/local/bin/agent-control-plane
ENV HOST=0.0.0.0
ENV PORT=8080
EXPOSE 8080
CMD ["agent-control-plane"]
