# Agent Control Plane — production-like local beta profile
# Copy to .env.production-like.local and fill only local machine values.
# Do not commit .env.production-like.local or real provider/admin keys.

# --- Network: keep local by default ---
HOST=127.0.0.1
PORT=8080

# --- Storage / dashboard ---
ACP_DB_PATH=.agent-control-plane/production-like/local-team.db
ACP_BACKUP_DIR=.agent-control-plane/production-like/backups
ACP_DASHBOARD_DIR=dashboard/out

# --- Protected local API ---
ACP_REQUIRE_AUTH=1
# Generate with: uv run --no-project python scripts/bootstrap_local_auth.py --json
# Must be harness_ followed by 64 hex chars in the copied local env file.
ACP_ADMIN_API_KEY=

# --- CN Anthropic trusted-local beta ---
ACP_PROVIDER_TYPE=anthropic
ACP_TRUSTED_LOCAL_PROFILE=1
# Legacy standalone gate remains supported when operating without the profile.
# ACP_ENABLE_PROVIDER_EXECUTION=1
ACP_BASE_URL=https://token-plan-cn.xiaomimimo.com/anthropic
ACP_MODEL=mimo-v2.5

# ACP_API_KEY is the name of the environment variable that contains the secret.
# Export this variable in your shell or local untracked env file.
ACP_API_KEY=ACP_CN_ANTHROPIC_API_KEY
# Export this in your shell or uncomment only in your untracked local copy.
# ACP_CN_ANTHROPIC_API_KEY=

# Adaptive endpoint registry used by the trusted-local profile. Keep credential
# values out of this JSON; credential_env names the local environment variable.
ACP_ADAPTIVE_PROVIDER_ENDPOINTS_JSON='[{"endpoint_id":"cn-anthropic","provider_type":"anthropic","base_url":"https://token-plan-cn.xiaomimimo.com/anthropic","model":"mimo-v2.5","credential_env":"ACP_CN_ANTHROPIC_API_KEY","timeout_ms":60000,"input_cost_per_1k_usd":0.001,"output_cost_per_1k_usd":0.002}]'

# --- Cost gates: keep low for trial runs ---
ACP_COST_PER_DISPATCH_USD=0.10
ACP_COST_DAILY_USD=1.00

# --- Provider price visibility ---
# Optional explicit price rates for estimated_cost_usd.
# Fill with current CN node rates when known; leave commented to show pricing_configured=false.
# ACP_PROVIDER_INPUT_COST_PER_1K_USD=0.000
# ACP_PROVIDER_OUTPUT_COST_PER_1K_USD=0.000
