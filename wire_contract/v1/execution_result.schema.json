{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://token-efficient-agent-harness-lab.local/wire_contract/v1/execution_result.schema.json",
  "title": "ExecutionResult v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "result_id",
    "dispatch_id",
    "decision_id",
    "executor_type",
    "status",
    "output",
    "prompt_pack",
    "input_tokens",
    "output_tokens",
    "estimated_cost",
    "latency_ms",
    "error_domain",
    "error_message",
    "provider_request_id",
    "attempt_number",
    "finish_reason",
    "usage_source",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "execution_result.v1"
    },
    "result_id": {
      "type": "string"
    },
    "dispatch_id": {
      "type": "string"
    },
    "decision_id": {
      "type": "string"
    },
    "executor_type": {
      "type": "string",
      "enum": [
        "noop",
        "mock",
        "manual",
        "provider"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "not_executed",
        "preview_generated",
        "mock_completed",
        "manual_pending",
        "manual_completed",
        "failed"
      ]
    },
    "output": {
      "type": [
        "string",
        "null"
      ]
    },
    "prompt_pack": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true
    },
    "input_tokens": {
      "type": [
        "integer",
        "null"
      ]
    },
    "output_tokens": {
      "type": [
        "integer",
        "null"
      ]
    },
    "estimated_cost": {
      "type": [
        "number",
        "null"
      ]
    },
    "latency_ms": {
      "type": [
        "integer",
        "null"
      ]
    },
    "error_domain": {
      "type": [
        "string",
        "null"
      ]
    },
    "error_message": {
      "type": [
        "string",
        "null"
      ]
    },
    "provider_request_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "attempt_number": {
      "type": [
        "integer",
        "null"
      ]
    },
    "finish_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "usage_source": {
      "type": [
        "string",
        "null"
      ]
    },
    "created_at": {
      "type": "string"
    }
  }
}
