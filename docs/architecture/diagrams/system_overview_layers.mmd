flowchart TD
  %% ===== Nodes =====
  Human["Human Owner<br/>目标 / 审批 / 最终验收"]

  subgraph PM["Project Management Plane"]
    PBri["Project Brief<br/>目标来源"]
    PArch["Project Architect / PM Agent<br/>项目拆解"]
    PBoard["Project Board<br/>状态事实源"]
    MContract["Module Contracts<br/>模块契约"]
    TPack["Test Case Packs<br/>测试包"]
    PGraph["Project Dependency Graph<br/>项目依赖图"]
  end

  subgraph BQ["Batch Intake & Queue"]
    Handoff["Project-to-Queue Handoff"]
    TQueue["Task Queue<br/>执行队列"]
    DepMgr["Cross-task Dependency Manager"]
  end

  subgraph CTRL["Control Plane"]
    Intake["Intake / Triage"]
    Planner["Planner ↔ Architect<br/>任务级规划"]
    DAG["DAG Compiler"]
    Resource["Resource Binder / Context Broker"]
    Budget["Budget Controller"]
    Policy["Policy Engine"]
  end

  Orch["Orchestrator Core<br/>deterministic authority<br/>不拥有目标 / 不拥有记忆 / 不直接改策略"]

  subgraph ADV["Advisor Plane"]
    AdvPre["Advisor Preflight"]
    AdvRisk["Risk Scan"]
    AdvFix["Correction / Arbitration"]
  end

  subgraph EXE["Execution Plane"]
    Sandbox["Sandbox Manager"]
    Gateway["Model Gateway / Stub"]
    Workers["Worker Nodes<br/>Research / Builder / Test / Doc / Config"]
    Checkpoint["Checkpoint Writer"]
  end

  subgraph VER["Verification & Integration Plane"]
    Verifier["Verifier"]
    Reviewer["Reviewer"]
    Scoring["Scoring Engine"]
    ArtifactGate["Artifact Gate"]
    FinalGate["Final Gate<br/>最高准入函数"]
  end

  subgraph EVAL["Evaluation Plane"]
    RWRO["Real-World Read-Only Eval"]
    HCE["Harness Change Eval"]
    UStyle["User-Style Mutation Eval"]
    Usage["Usage Ledger / Cost-of-Pass"]
    EvalAdmission["Evaluation Admission Contract<br/>admitted vs diagnostic evidence"]
  end

  subgraph GOV["Governance & Policy Plane"]
    Candidate["Policy Candidate Manifest"]
    EvidencePack["Candidate Evidence Pack"]
    Approval["Approval Record<br/>Human Approval Required"]
    Rollback["Rollback Plan"]
    Registry["Policy Registry"]
  end

  subgraph MEM["Memory & Optimization Plane"]
    RunLogs["Run Logs"]
    EvalRecords["Eval Records"]
    Retro["Retrospective"]
    Skills["Skill Library"]
    Baseline["Baseline Store"]
    Feedback["Keep Rate / User Feedback"]
  end

  %% ===== Main data flow =====
  Human --> PBri
  PBri --> PArch
  PArch --> PBoard
  PArch --> MContract
  PArch --> TPack
  PArch --> PGraph
  PBoard --> Handoff
  PGraph --> DepMgr
  Handoff --> TQueue
  DepMgr --> TQueue

  TQueue --> Intake
  Intake --> Planner
  Planner --> DAG
  DAG --> Resource
  Resource --> Budget
  Budget --> Policy
  Policy --> Orch

  Orch --> AdvPre
  AdvPre --> AdvRisk
  AdvRisk --> AdvFix
  AdvFix --> Orch

  Orch --> Sandbox
  Sandbox --> Gateway
  Gateway --> Workers
  Workers --> Checkpoint
  Checkpoint --> Orch

  Workers --> Verifier
  Verifier --> Reviewer
  Reviewer --> Scoring
  Scoring --> ArtifactGate
  ArtifactGate --> FinalGate
  FinalGate --> PBoard

  FinalGate --> RunLogs
  RunLogs --> EvalRecords
  EvalRecords --> Retro
  Retro --> Skills
  EvalRecords --> Baseline
  FinalGate --> Feedback

  %% ===== Evaluation / Governance policy candidate flow =====
  RunLogs --> RWRO
  EvalRecords --> HCE
  Feedback --> HCE
  RWRO --> EvalAdmission
  HCE --> EvalAdmission
  UStyle --> EvalAdmission
  Usage --> EvalAdmission

  EvalAdmission --> Candidate
  Candidate --> EvidencePack
  EvidencePack --> Approval
  Approval --> Rollback
  Rollback --> Registry
  Registry -.approved policy / config / schema / profile.-> Policy

  %% ===== Orchestrator authority relations =====
  Orch -.coordinates.-> PBoard
  Orch -.coordinates.-> TQueue
  Orch -.calls gates.-> FinalGate
  Orch -.writes events only.-> RunLogs
  Orch -.does not self-authorize.-> GOV

  %% ===== Classes =====
  classDef core fill:#e8f1ff,stroke:#2f66c5,stroke-width:1px,color:#0b1f44;
  classDef eval fill:#fff4d6,stroke:#c78a00,stroke-width:1px,color:#3d2b00;
  classDef gov fill:#f3e8ff,stroke:#7b2cbf,stroke-width:1px,color:#2d0a4f;
  classDef mem fill:#e8f8ef,stroke:#2e8b57,stroke-width:1px,color:#0b3d22;
  classDef orch fill:#ffe8e8,stroke:#c53030,stroke-width:3px,color:#4a0000;
  classDef human fill:#f5f5f5,stroke:#555,stroke-width:1px,color:#111;

  class PBri,PArch,PBoard,MContract,TPack,PGraph,Handoff,TQueue,DepMgr,Intake,Planner,DAG,Resource,Budget,Policy,AdvPre,AdvRisk,AdvFix,Sandbox,Gateway,Workers,Checkpoint,Verifier,Reviewer,Scoring,ArtifactGate,FinalGate core;
  class RWRO,HCE,UStyle,Usage,EvalAdmission eval;
  class Candidate,EvidencePack,Approval,Rollback,Registry gov;
  class RunLogs,EvalRecords,Retro,Skills,Baseline,Feedback mem;
  class Orch orch;
  class Human human;
